POSTGRES_DB=court_signup
POSTGRES_USER=court_signup
POSTGRES_PASSWORD=court_signup
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Set by a managed Postgres provider (e.g. Render) as a single connection
# string -- when present, config/settings.py uses this INSTEAD of the 5
# POSTGRES_* vars above and requires SSL. Leave unset for local dev; the
# docker-compose `db` service is only reachable via the broken-out vars
# above, not a URL.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Local dev defaults -- every value below is safe to leave unset locally.
# For a real deployment, set all of these explicitly:
#   DJANGO_SECRET_KEY        - a real random secret (e.g. `python -c
#                               "import secrets; print(secrets.token_urlsafe(50))"`),
#                               never the placeholder below
#   DJANGO_DEBUG              - False
#   DJANGO_ALLOWED_HOSTS       - comma-separated real domain(s), e.g. "example.com,www.example.com"
#   CORS_ALLOWED_ORIGINS       - comma-separated real frontend origin(s), e.g. "https://example.com"
#   DJANGO_CSRF_TRUSTED_ORIGINS - comma-separated real frontend origin(s) (same as above, with scheme)
#   DJANGO_TRUST_PROXY_HEADER  - True only if actually behind a reverse proxy that
#                                sets X-Forwarded-Proto (e.g. Render/Railway/Fly)
#   DJANGO_SECURE              - True once actually served over HTTPS
DJANGO_SECRET_KEY=change-me-in-real-deployments
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5183
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HEADER=False
DJANGO_SECURE=False

# Optional, used only by `python manage.py seed_staff_account`. If unset,
# that command generates a fresh random password itself and prints it
# once -- set this only for a reproducible password in local/CI seeding.
# SEED_STAFF_PASSWORD=
