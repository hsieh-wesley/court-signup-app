# Local dev only needs this if your API isn't on the default localhost:8000.
# For a PRODUCTION build (`npm run build` / `vite build`), this variable is
# REQUIRED -- the build itself fails loudly if it's unset, rather than
# silently shipping a build that calls localhost. Set it to the real,
# deployed API host -- on Vercel, set this as a project environment
# variable (not in a committed .env file), e.g.:
#   VITE_API_BASE_URL=https://courtflow-api-production.up.railway.app/api
VITE_API_BASE_URL=http://localhost:8000/api
